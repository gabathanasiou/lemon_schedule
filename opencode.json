{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "urls": ["https://supabase.com/.well-known/agent-skills/"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "environment": {}
    },
    "lemon": {
      "type": "local",
      "command": ["node", "tools/mcp/lemon-mcp.mjs"],
      "environment": {}
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?features=database,debugging,development,docs",
      "enabled": true
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    }
  }
}