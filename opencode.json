{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "urls": ["https://supabase.com/.well-known/agent-skills/"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["sh", "-c", "f=\"$HOME/.config/opencode/skills/agent-window-labels/window-label.cjs\"; if [ -f \"$f\" ]; then set -- \"$@\" --init-page \"$f\"; fi; exec npx @playwright/mcp@latest \"$@\""],
      "environment": {}
    },
    "gcloud": {
      "type": "local",
      "command": ["npx", "-y", "@google-cloud/gcloud-mcp"],
      "environment": {}
    },
    "lemon": {
      "type": "local",
      "command": ["node", "tools/mcp/lemon-mcp.mjs"],
      "environment": {}
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?features=database,debugging,development,docs",
      "enabled": true
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    }
  }
}