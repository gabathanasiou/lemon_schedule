# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Client ID from Google Cloud Console.
# Create one at https://console.cloud.google.com/apis/credentials
# Set as "Web application" type, add http://localhost:3000 to authorized JavaScript origins (dev).
# For production (GitHub Pages), also add https://YOUR_USERNAME.github.io to authorized origins.
VITE_GOOGLE_CLIENT_ID="YOUR_CLIENT_ID"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: online collaboration (roadmap 229).
# From the Supabase dashboard → Project Settings → API (Project URL + publishable
# key — the key is public by design; never use the service_role key here).
# Leave unset for a local/Drive-only build: the collaboration UI stays hidden.
# VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# VITE_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_KEY"

# VITE_ROOMS_URL: S4 realtime rooms worker (roadmap 229). Unset = rooms off in
# production builds. Local dev: the dev server auto-starts the worker
# (tools/rooms-dev.mjs) and the app defaults to http://127.0.0.1:8787 — no
# .env edit needed. Set it only to override (another port for parallel work,
# or the deployed worker: https://lemon-rooms.<subdomain>.workers.dev — set as
# a repo secret like the Supabase ones; holding the URL is not enough, every
# connection needs a valid room token).
#VITE_ROOMS_URL="http://127.0.0.1:8787"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps/Places API key (same Google
# Cloud project as the Drive client). When set, address search + reverse
# geocoding use Google Places (New) + Geocoding instead of the default keyless
# Nominatim/OpenStreetMap provider; the weather-location reverse geocode follows
# the same switch. Requires billing + the "Places API (New)" and "Geocoding API"
# enabled. The key ships in the public bundle — restrict it in Google Cloud
# (HTTP referrers + those two APIs only, daily quota caps, budget alert);
# setup checklist: docs/SECURITY.md §6. Deploys read it from the repo secret of
# the same name (deploy.yml).
# VITE_GOOGLE_MAPS_API_KEY="YOUR_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LEMON_TEST_SB_USER_A / LEMON_TEST_SB_PASS_A (+ _B): reusable ROBOT Supabase
# accounts for the MANUAL room harness (workers/rooms/test/two-window-repro.mjs,
# plus any future two-window checks). Local dev only — never deployed, never
# committed. Don't write these by hand: run
#   node workers/rooms/test/ensure-test-accounts.mjs
# once — it creates the pair (or re-creates a deleted one) and appends the
# credentials here, so harness runs stop creating throwaway users. The harness
# deletes the throwaway `projects` row it creates.
# LEMON_TEST_SB_USER_A="lemon-agent-a@example.com"
# LEMON_TEST_SB_PASS_A="YOUR_ROBOT_PASSWORD"
# LEMON_TEST_SB_USER_B="lemon-agent-b@example.com"
# LEMON_TEST_SB_PASS_B="YOUR_ROBOT_PASSWORD"
